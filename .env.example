# انسخ هذا الملف إلى .env محلياً، وعلى CranL ضع نفس المتغيرات في إعدادات التطبيق (Environment)
# رابط قاعدة البيانات: CranL يضعه تلقائياً عند ربط قاعدة PostgreSQL بالتطبيق
DATABASE_URL=postgres://user:password@host:5432/livedeck
# true إذا كانت قاعدة البيانات تتطلب SSL (الاتصال من خارج شبكة CranL)
DATABASE_SSL=false
# سر توقيع رموز الدخول: نص عشوائي طويل (48 حرفاً أو أكثر) لا يُشارك أبداً
JWT_SECRET=change-me-to-a-long-random-string
PORT=3000
# المواقع المسموح لها باستدعاء الـ API (نسخة الويب). التطبيق المكتبي لا يحتاجها
CORS_ORIGINS=https://your-web-domain.example
TRIAL_DAYS=30
# صفحة الدفع التي يفتحها زر «اشترك الآن» (اختياري حتى تربط بوابة دفع)
PAYMENT_URL=
